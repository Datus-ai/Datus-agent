# Legacy JWT endpoints are disabled until credentials and a signing key are configured.
# Copy to {agent.home}/conf/auth_clients.yml and replace the null values below.
# Generate a separate random value for each secret, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the completed file private (for example, chmod 600); never commit secrets.
clients:
  your_client_id: null
jwt:
  # A nonempty JWT_SECRET_KEY environment variable overrides this value.
  # An empty or whitespace-only environment variable disables legacy authentication.
  secret_key: null
  algorithm: HS256
  expiration_hours: 2
