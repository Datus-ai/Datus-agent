  workflow:
    plan: bird_reason2
    bird_reason:
    - schema_linking
    - reasoning
    - execute_sql
    - output
    bird_reason2:
    - chat
    - execute_sql
    - output
    bird_reflection:
    - schema_linking
    - generate_sql
    - execute_sql
    - reflect
    - output
    bird_reflection2:
    - schema_linking
    - reason_sql
    - execute_sql
    - reflect
    - output
    metrics_to_sql:
    - schema_linking
    - search_metrics
    - generate_sql
    - execute_sql
    - output

  storage:
    workspace_root: /Users/zhaoheng/src/Datus-agent/sqls
    base_path: data
    database:
      model_name: all-MiniLM-L6-v2
      dim_size: 384
      registry_name: sentence-transformers
agentic_nodes:
  dfsdfdsfs:
    system_prompt: dfsdfdsfs
    prompt_version: '1.0'
    prompt_language: en
    agent_description: sdfdsfdsf
    tools: context_search_tools.search_metrics, context_search_tools.search_documents,
      context_search_tools.search_historical_sql
    mcp: metricflow.get_entities
    rules: []
