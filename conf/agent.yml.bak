agent:
  target: deepseek-v3
  models:
    local-qwq-32B:
      type: qwen
      vendor: openai
      base_url: http://localhost:8000/v1
      api_key: ${OPENAI_API_KEY}
      model: /root/onethingai-fs/QwQ-32B-unsloth-bnb-4bit
    qwen-coder:
      type: qwen
      base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
      api_key: ${DASHSCOPE_API_KEY}
      model: qwen3-coder-plus
    kimi-k2:
      type: kimi
      vendor: moonshot
      base_url: https://api.moonshot.cn/v1
      api_key: ${KIMI_API_KEY}
      model: kimi-k2-0711-preview
    kimi-k2-turbo:
      type: kimi
      vendor: moonshot
      base_url: https://api.moonshot.cn/v1
      api_key: ${KIMI_API_KEY}
      model: kimi-k2-turbo-preview
    o4-mini:
      type: openai
      base_url: https://api.openai.com/v1
      api_key: ${OPENAI_API_KEY}
      model: o4-mini
    gptoss:
      type: openai
      base_url: http://localhost:8000/v1
      api_key: ${OPENAI_API_KEY}
      model: gpt-oss-120b
    gpt5:
      type: openai
      base_url: https://api.openai.com/v1
      api_key: ${OPENAI_API_KEY}
      model: gpt-5
    gpt4.1:
      type: openai
      base_url: https://api.openai.com/v1
      api_key: ${OPENAI_API_KEY}
      model: gpt-4.1
    deepseek-v3:
      type: deepseek
      vendor: deepseek
      base_url: https://api.deepseek.com
      api_key: ${DEEPSEEK_API_KEY}
      model: deepseek-chat
    deepseek-r1:
      type: deepseek
      vendor: deepseek
      base_url: https://api.deepseek.com
      api_key: ${DEEPSEEK_API_KEY}
      model: deepseek-reasoner
    deepseek-ark:
      type: deepseek
      vendor: ark
      base_url: https://ark.cn-beijing.volces.com/api/v3
      api_key: ${DEEPSEEK_ARK_API_KEY}
      model: deepseek-v3-250324
    deepseek-ark-r1:
      type: deepseek
      vendor: ark
      base_url: https://ark.cn-beijing.volces.com/api/v3
      api_key: ${DEEPSEEK_ARK_API_KEY}
      model: deepseek-r1-250120
    claude-3.7-sonnet:
      type: claude
      vendor: anthropic
      base_url: https://api.anthropic.com
      api_key: ${ANTHROPIC_API_KEY}
      model: claude-3-7-sonnet-20250219
    claude-opus-4:
      type: claude
      vendor: anthropic
      base_url: https://api.anthropic.com
      api_key: ${ANTHROPIC_API_KEY}
      model: claude-opus-4-20250514
    claude-haiku-4.5:
      type: claude
      vendor: anthropic
      base_url: https://api.anthropic.com
      api_key: ${ANTHROPIC_API_KEY}
      model: claude-haiku-4-5
    claude-sonnet-4:
      type: claude
      vendor: anthropic
      base_url: https://api.anthropic.com
      api_key: ${ANTHROPIC_API_KEY}
      model: claude-sonnet-4-20250514
    gemini-2.5:
      type: gemini
      vendor: google
      base_url: https://generativelanguage.googleapis.com/v1beta
      api_key: ${GEMINI_API_KEY}
      model: gemini-2.5-flash-lite
  benchmark:
    bird_dev:
      benchmark_path: /Users/zhaoheng/src/Datus-agent/benchmark/bird/dev_20240627
    spider2:
      benchmark_path: benchmark/spider2/spider2-snow
    semantic_layer:
      benchmark_path: benchmark/semantic_layer
  namespace:
    local_sqlite:
      type: sqlite
      dbs:
      - name: ssb
        uri: sqlite:////Users/zhaoheng/src/SSB-sqlite/SSB.db
    spidersnow:
      type: snowflake
      username: ${SNOWFLAKE_USER}
      account: ${SNOWFLAKE_ACCOUNT}
      warehouse: ${SNOWFLAKE_WAREHOUSE}
      password: ${SNOWFLAKE_PASSWORD}
    snowflake:
      type: snowflake
      username: ${SNOWFLAKE_USER}
      account: ${SNOWFLAKE_ACCOUNT}
      warehouse: ${SNOWFLAKE_WAREHOUSE}
      password: ${SNOWFLAKE_PASSWORD}
    local_duckdb:
      type: duckdb
      name: demo
      uri: ./tests/duckdb-demo.duckdb
    duckdb:
      type: duckdb
      name: duck
      uri: ~/.metricflow/duck.db
    california_schools:
      type: duckdb
      name: california_schools
      uri: ./california_schools.duckdb
    mf_demo:
      schema: mf_demo
      uri: ~/.metricflow/duck.db
    bird_sqlite:
      type: sqlite
      path_pattern: benchmark/bird/dev_20240627/dev_databases/**/*.sqlite
    bird_school:
      type: sqlite
      name: california_schools
      uri: benchmark/bird/dev_20240627/dev_databases/california_schools/california_schools.sqlite
    bird_school2:
      type: sqlite
      name: california_schools
      uri: california_schools.sqlite
    california:
      type: sqlite
      name: california_schools
      uri: benchmark/bird/dev_20240627/dev_databases/california_schools/california_schools.sqlite
    sr2:
      type: starrocks
      username: ${STARROCKS_USER}
      password: ${STARROCKS_PASSWORD}
      host: ${STARROCKS_HOST}
      port: ${STARROCKS_PORT}
      database: ${STARROCKS_DATABASE}
    sr:
      type: starrocks
      username: admin
      password: Just4Fun1!
      host: knwes05y3.cloud-app.celerdata.com
      port: 9030
      database: ssb_1
  agentic_nodes:
    ref_tpl_test:
      model: deepseek-v3
      system_prompt: ref_tpl
      prompt_version: '1.0'
      prompt_language: en
      max_turns: 10
      tools: context_search_tools.list_subject_tree, reference_template_tools.search_reference_template, reference_template_tools.get_reference_template, reference_template_tools.execute_reference_template
##chat:
#      prompt_version: '1.0'
##model: gpt4.1
#      model: claude-haiku-4.5
##     model: kimi-k2-turbo
#      max_turns: 50
#    sql:
#      prompt_version: '1.0'
##      model: claude-haiku-4.5
##      model: gpt4.1
#      model: kimi-k2-turbo
#      max_turns: 50
    school:
      model: kimi-k2-turbo
      system_prompt: sql
      prompt_version: '1.0'
      prompt_language: en
      max_turns: 30
      tools: db_tools, context_search_tools
      rules:
      - try to search_sql_history before write sql
    chatbot:
#model: kimi-k2-turbo
      model: kimi-k2-turbo
      system_prompt: sql
      prompt_version: '1.0'
      prompt_language: en
      tools: db_tools.*, context_search_tools.*
      mcp: filesystem_mcp.*
      max_turns: 30
      rules:
      - Use filesystem tools to read SQL files from the current directory (*/*.sql)
        as reference examples
      - When SQL is involved, explain your approach and provide clear, executable
        queries
      - Always check reference SQL files(*.sql) in allowed directory for similar patterns
        before writing new queries
      - If context is provided, use the tables/metrics/sqls in user prompt.
      - Try to use database specific dialet
    chatbot2:
      model: deepseek-v3
      system_prompt: sql
      prompt_version: '1.0'
      prompt_language: en
      tools: db_tools.*, context_search_tools.search_table_metadata, context_search_tools.search_metrics
      workspace_root: /Users/zhaoheng/src/Datus-agent/school_sqls
      mcp: filesystem_mcp, metricflow
      rules:
      - Use filesystem tools to read SQL files from the current directory (*/*.sql)
        as reference examples
      - When SQL is involved, explain your approach and provide clear, executable
        queries
      - Always check reference SQL files(*.sql) in allowed directory for similar patterns
        before writing new queries
      - If context is provided, use the tables/metrics/sqls in user prompt.
      - Try to use database specific dialet
